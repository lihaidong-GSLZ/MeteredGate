<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Configurations>Debug;Release</Configurations>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>

    <!-- 只编译 src/，避免备份或文档目录中的 .cs 文件被自动纳入。 -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <AssemblyName>MeteredGate</AssemblyName>
    <RootNamespace>MeteredGate</RootNamespace>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>

    <!-- 生成稳定的托管程序集；不同机器仍可能因 SDK 版本而产生字节差异。 -->
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!-- COI_ROOT 指向游戏根目录，而不是 Managed 目录。 -->
    <COI_MANAGED_DIR>$(COI_ROOT)/Captain of Industry_Data/Managed</COI_MANAGED_DIR>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DefineConstants></DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <!-- Linux/macOS 上编译 net48 时提供编译期参考程序集；不会成为运行时依赖。 -->
  <ItemGroup>
    <PackageReference
      Include="Microsoft.NETFramework.ReferenceAssemblies"
      Version="1.0.3"
      PrivateAssets="All" />
  </ItemGroup>

  <!-- 游戏与 Unity 程序集只在编译时引用，不复制到 mod 输出目录。 -->
  <ItemGroup>
    <Reference Include="Mafi">
      <HintPath>$(COI_MANAGED_DIR)/Mafi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mafi.Core">
      <HintPath>$(COI_MANAGED_DIR)/Mafi.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mafi.Base">
      <HintPath>$(COI_MANAGED_DIR)/Mafi.Base.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mafi.Unity">
      <HintPath>$(COI_MANAGED_DIR)/Mafi.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>$(COI_MANAGED_DIR)/UnityEngine.UIElementsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 这些文件会复制到 bin/<配置>/net48，方便手动制作发行包。 -->
  <ItemGroup>
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="readme.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="changelog.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 在真正进入 C# 编译前给出明确的路径错误。 -->
  <Target Name="ValidateCoiReferences" BeforeTargets="ResolveReferences">
    <Error
      Condition="'$(COI_ROOT)' == ''"
      Text="COI_ROOT is empty. Set it to the Captain of Industry installation directory." />
    <Error
      Condition="!Exists('$(COI_MANAGED_DIR)/Mafi.dll')"
      Text="Cannot find Mafi.dll under COI_ROOT: $(COI_ROOT)" />
    <Error
      Condition="!Exists('$(COI_MANAGED_DIR)/Mafi.Core.dll')"
      Text="Cannot find Mafi.Core.dll under COI_ROOT: $(COI_ROOT)" />
    <Error
      Condition="!Exists('$(COI_MANAGED_DIR)/Mafi.Base.dll')"
      Text="Cannot find Mafi.Base.dll under COI_ROOT: $(COI_ROOT)" />
    <Error
      Condition="!Exists('$(COI_MANAGED_DIR)/Mafi.Unity.dll')"
      Text="Cannot find Mafi.Unity.dll under COI_ROOT: $(COI_ROOT)" />
    <Error
      Condition="!Exists('$(COI_MANAGED_DIR)/UnityEngine.UIElementsModule.dll')"
      Text="Cannot find UnityEngine.UIElementsModule.dll under COI_ROOT: $(COI_ROOT)" />
  </Target>
</Project>
